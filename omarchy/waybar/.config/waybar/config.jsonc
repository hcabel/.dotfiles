{
    "include": [
        "../../../../base/waybar/.config/waybar/modules.jsonc",
        "./omarchy.jsonc"
    ],
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "modules-left": [
        "custom/omarchy",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "custom/notification",
        "custom/omarchy/update",
    ],
    "modules-right": [
        "group/tray-expander",
        "bluetooth",
        "network",
        "pulseaudio",
        "battery",
        "clock",
    ],
}
